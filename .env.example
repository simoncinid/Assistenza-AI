# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://www.assistenza-ai.it

# Public contact email (Aruba) - shown on site once confirmed by Diego
NEXT_PUBLIC_CONTACT_EMAIL=info@assistenza-ai.it

# Cloudflare Web Analytics (cookie-less, free tier)
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Google Search Console HTML meta tag verification token (if HTML method is chosen)
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional Cloudflare Turnstile site key & secret (free tier anti-spam)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead capture -> Dedicated Notion database (Lead Assistenza AI)
NOTION_TOKEN=
NOTION_LEADS_DB_ID=

# Optional webhook for instant lead notifications
LEAD_WEBHOOK_URL=
